# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Explicitly force LF for Java and Maven files (safeguard for cross-platform)
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.css text eol=lf
*.fxml text eol=lf

# Shell scripts (Linux/Mac) must use LF
*.sh text eol=lf
mvnw text eol=lf

# Windows scripts must use CRLF to execute properly
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files (Git should not try to merge or diff them)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.exe binary
*.dll binary
*.jar binary
