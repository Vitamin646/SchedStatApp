<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.vitamin646dev.schedstatapp.controller.HomeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="welcomeText"/>

    <Label fx:id="todayTitle" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
    <Label fx:id="todayText" wrapText="true"/>

    <Label fx:id="weekTitle" style="-fx-font-size: 16px; -fx-font-weight: bold;">
        <VBox.margin>
            <Insets top="12.0"/>
        </VBox.margin>
    </Label>
    <Label fx:id="weekText" wrapText="true"/>
</VBox>
