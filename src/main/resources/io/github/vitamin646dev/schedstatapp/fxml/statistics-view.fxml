<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.vitamin646dev.schedstatapp.controller.StatisticsController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Workout statistics" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- Chart -->
    <BarChart fx:id="workoutChart" title="Workout minutes by day of week" legendSide="TOP">
        <xAxis>
            <CategoryAxis label="Day of week" />
        </xAxis>
        <yAxis>
            <NumberAxis label="Minutes" />
        </yAxis>
    </BarChart>

    <Label fx:id="totalTimeLabel" text="Total time: 0 hours" style="-fx-font-size: 14px;" />

</VBox>