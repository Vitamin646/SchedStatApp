<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="io.github.vitamin646dev.schedstatapp.controller.LogWorkoutController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Log workout" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox spacing="8.0">
        <DatePicker fx:id="datePicker"/>
        <ComboBox fx:id="statusBox"/>
        <TextField fx:id="tagsField" promptText="Tags (comma separated)" HBox.hgrow="ALWAYS"/>
    </HBox>
    <TextField fx:id="notesField" promptText="Notes"/>

    <HBox spacing="8.0">
        <ComboBox fx:id="exerciseBox" promptText="Exercise" prefWidth="220.0"/>
        <TextField fx:id="repsField" promptText="Reps" prefWidth="70.0"/>
        <TextField fx:id="weightField" promptText="Weight, kg" prefWidth="100.0"/>
        <TextField fx:id="rpeField" promptText="RPE (opt.)" prefWidth="90.0"/>
        <Button text="Add set" onAction="#onAddSetButtonClick"/>
    </HBox>

    <TableView fx:id="setsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="exerciseColumn" text="Exercise" prefWidth="260.0"/>
            <TableColumn fx:id="repsColumn" text="Reps" prefWidth="80.0"/>
            <TableColumn fx:id="weightColumn" text="Weight, kg" prefWidth="100.0"/>
            <TableColumn fx:id="rpeColumn" text="RPE" prefWidth="80.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label fx:id="statusLabel"/>

    <HBox spacing="8.0">
        <Button text="Remove selected set" onAction="#onRemoveSetButtonClick"/>
        <Button text="Save workout" onAction="#onSaveButtonClick"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>
</VBox>
