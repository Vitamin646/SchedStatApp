<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="TOP_LEFT" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.schedstatapp.SettingsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Экран настроек" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="Toggle1" onAction="#onToggle1ButtonClick"/>
        <Label fx:id="label1" text="mode11"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="Toggle2" onAction="#onToggle2ButtonClick"/>
        <Label fx:id="label2" text="mode21"/>
    </HBox>

    <Button text="На главную" onAction="#onHomeButtonClick"/>
</VBox>
