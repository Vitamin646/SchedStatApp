<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import com.calendarfx.view.CalendarView?>

<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.schedstatapp.controller.CalendarController">

    <top>
        <Label text="Мой календарь тренировок" style="-fx-font-size: 18px; -fx-padding: 10px;"/>
    </top>

    <center>
        <CalendarView fx:id="calendarView" />
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Button text="Перейти к статистике" onAction="#onStatisticsButtonClick"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white;">
                <BorderPane.margin>
                    <Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/>
                </BorderPane.margin>
            </Button>
            <Button text="Home" onAction="#onHomeButtonClick"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white;">
                <BorderPane.margin>
                    <Insets top="10.0" bottom="10.0" left="10.0" right="10.0"/>
                </BorderPane.margin>
            </Button>
        </HBox>
    </bottom>

</BorderPane>
