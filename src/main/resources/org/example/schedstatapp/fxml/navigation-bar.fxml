<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>

<!-- Buttons are added by NavigationBarController, one per ViewType -->
<HBox fx:id="navigationBar" alignment="CENTER_LEFT" spacing="10.0"
      style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.schedstatapp.controller.NavigationBarController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</HBox>
