<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.CheckBox?>
<VBox alignment="TOP_LEFT" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.schedstatapp.controller.SettingsController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Экран настроек" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <CheckBox fx:id="welcomeCheckBox" text="Показывать приветствие на главном экране"/>

    <Button text="Сохранить настройки" onAction="#onSaveButtonClick" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
</VBox>
